# Copy this file to .env for local configuration. Never commit .env.
# If SECRET_KEY and ADMIN_ACCESS_KEY are omitted, Daymark generates stable
# local files (.secret_key and .admin_access_key) on first run.

APP_NAME=Daymark

# Use PostgreSQL in production, or leave the default SQLite database in place.
# DATABASE_URL=postgresql+psycopg://postgres:1234@localhost/postgres
# DATABASE_URL=sqlite:///./todo.db

# 480 minutes = 8 hours
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Set true when serving over HTTPS.
COOKIE_SECURE=false

# Optional: restrict the browser developer door to one account.
# DEVELOPER_EMAIL=you@example.com

# Strongly recommended in production (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
# SECRET_KEY=
# ADMIN_ACCESS_KEY=
